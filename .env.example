# Formspree form ID for the contact form (formspree.io -> create a form -> copy the ID from the endpoint URL).
# Without this set, the contact form falls back to opening a pre-filled mailto: link.
NEXT_PUBLIC_FORMSPREE_ID=

# Anthropic API key for the visitor chat widget (console.anthropic.com). Required — without it
# /api/chat returns a clear "not configured" error instead of the widget silently failing.
ANTHROPIC_API_KEY=

# Optional: override the model used for chat replies (defaults to claude-haiku-4-5-20251001).
ANTHROPIC_CHAT_MODEL=

# Optional: a SEPARATE Formspree form ID (create a second form at formspree.io, don't reuse the
# contact form's ID) used to email every chat widget question + reply to Ahmed for review. Leave
# unset to skip logging entirely — server-side only, never exposed to the client.
FORMSPREE_CHAT_LOG_ID=
